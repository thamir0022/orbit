{
  "name": "orbit",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "scripts": {
    "api:dev": "docker compose up --watch",
    "client:dev": "pnpm --filter client dev",
    "admin:dev": "pnpm --filter admin dev",
    "permission:sync": "docker compose exec api pnpm cli:permission-sync",
    "role:sync": "docker compose exec api pnpm cli:role-sync",
    "admin:create": "docker compose exec api pnpm cli:admin-create",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint-staged": "lint-staged",
    "ci:verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "lint-staged": {
    "apps/api/**/*.{ts,tsx,json}": [
      "pnpm --filter api lint --fix"
    ],
    "apps/client/**/*.{ts,tsx,json}": [
      "pnpm --filter client lint --fix"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6"
  }
}
